<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="mb-1"><i class="bi bi-journal-text text-eco"></i> Registro de auditoría</h1>
        <p class="text-muted-eco mb-0">Historial inmutable de las acciones de los administradores (últimos 200).</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin" class="btn btn-outline-light">Volver</a>
        <a href="/admin/auditoria/exportar" class="btn btn-eco"><i class="bi bi-download"></i> Exportar CSV</a>
    </div>
</div>

<div class="glass p-3">
    <% if (registros.length === 0) { %>
        <div class="empty-state">Todavía no hay acciones registradas.</div>
    <% } else { %>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Fecha y hora</th><th>Administrador</th><th>Acción</th><th>Descripción</th></tr></thead>
            <tbody>
            <% registros.forEach(r => { %>
                <tr>
                    <td class="text-nowrap small"><%= new Date(r.fecha_hora).toLocaleString('es-CL') %></td>
                    <td><%= r.admin_nombre %><div class="small text-muted-eco"><%= r.admin_correo %></div></td>
                    <td><span class="badge text-bg-secondary"><%= r.accion %></span></td>
                    <td class="small"><%= r.descripcion %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <% } %>
</div>

<%- include('../partials/footer') %>