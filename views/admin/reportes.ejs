<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="mb-1"><i class="bi bi-file-earmark-spreadsheet text-eco"></i> Reportes y exportación</h1>
        <p class="text-muted-eco mb-0">Descarga archivos CSV para abrirlos en Excel.</p>
    </div>
    <a href="/admin" class="btn btn-outline-light">Volver</a>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="glass p-4 h-100">
            <h2 class="h5"><i class="bi bi-graph-up text-eco"></i> Lecturas de sensores</h2>
            <p class="text-muted-eco small">Temperatura, humedad ambiental, humedad de suelo, luz y calidad del aire.</p>
            <form action="/admin/reportes/lecturas" method="GET">
                <label class="form-label" for="periodo">Período</label>
                <select name="periodo" id="periodo" class="form-select mb-3">
                    <option value="24h">Últimas 24 horas</option>
                    <option value="7d">Últimos 7 días</option>
                    <option value="30d">Últimos 30 días</option>
                </select>
                <button class="btn btn-eco"><i class="bi bi-download"></i> Descargar lecturas</button>
            </form>
        </div>
    </div>
    <div class="col-md-6">
        <div class="glass p-4 h-100">
            <h2 class="h5"><i class="bi bi-people text-eco"></i> Base de usuarios</h2>
            <p class="text-muted-eco small">Listado de personas registradas con su rol y estado. No incluye contraseñas.</p>
            <a href="/admin/reportes/usuarios" class="btn btn-eco"><i class="bi bi-download"></i> Descargar usuarios</a>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>