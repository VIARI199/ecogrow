<%- include('../partials/header') %>
<% const color = { Critica: 'danger', Alta: 'danger', Media: 'warning', Baja: 'success' }; %>

<h1 class="mb-3">Alertas</h1>

<div class="mb-3 d-flex flex-wrap gap-2">
    <a href="<%= baseUrl %>" class="btn btn-sm <%= !filtro ? 'btn-eco' : 'btn-outline-eco' %>">Todas</a>
    <% estados.forEach(e => { %>
        <a href="<%= baseUrl %>?estado=<%= e %>" class="btn btn-sm <%= filtro === e ? 'btn-eco' : 'btn-outline-eco' %>"><%= e %></a>
    <% }) %>
</div>

<% if (alertas.length === 0) { %>
    <div class="glass empty-state">🟢 No hay alertas.</div>
<% } %>

<% alertas.forEach(a => { %>
    <div class="glass p-3 mb-2 d-flex flex-wrap justify-content-between align-items-center gap-2 <%= a.estado !== 'Nueva' ? 'opacity-75' : '' %>">
        <div>
            <span class="badge text-bg-<%= color[a.nivel_urgencia] %>"><%= a.nivel_urgencia %></span>
            <b class="ms-1"><%= a.tipo_alerta %></b>
            <div><%= a.mensaje %></div>
            <div class="small text-muted-eco"><%= new Date(a.fecha_hora).toLocaleString('es-CL') %> · <%= a.estado %></div>
        </div>
        <div class="d-flex gap-1">
            <% ['Reconocida', 'Resuelta', 'Descartada'].forEach(e => { if (a.estado !== e) { %>
                <form action="<%= baseUrl %>/<%= a.ID_alerta %>/estado" method="POST">
                    <input type="hidden" name="estado" value="<%= e %>">
                    <button class="btn btn-sm btn-outline-light"><%= e %></button>
                </form>
            <% } }) %>
            <form action="<%= baseUrl %>/<%= a.ID_alerta %>/delete" method="POST" onsubmit="return confirm('¿Eliminar alerta?')">
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
            </form>
        </div>
    </div>
<% }) %>

<%- include('../partials/footer') %>
