<%- include('../partials/header') %>

<div class="public-center">
    <div class="w-100">
        <div class="text-center mb-4">
            <img class="eco-logo float" src="/img/logo.svg" width="62" height="62" alt="EcoGrow">
            <h1 class="mt-3 mb-1" style="font-size:2rem">Recuperar contraseña</h1>
            <p class="text-muted-eco small mb-0">Te enviaremos un código de 6 dígitos a tu correo 🌱</p>
        </div>

        <div class="auth-box glass p-4 p-md-5">
            <form action="/olvide-contrasena" method="POST">
                <div class="mb-4">
                    <label class="form-label" for="correo">Correo electrónico</label>
                    <div class="input-icon">
                        <i class="bi bi-envelope"></i>
                        <input type="email" id="correo" name="correo" class="form-control" placeholder="tu@correo.com" autocomplete="email" required>
                    </div>
                </div>
                <button class="btn btn-eco w-100 py-2" style="color:var(--primary-foreground)">Enviar código</button>
            </form>
            <p class="text-center mt-3 mb-0 small text-muted-eco"><a href="/login">Volver al inicio de sesión</a></p>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>