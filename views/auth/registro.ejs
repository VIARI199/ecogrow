<%- include('../partials/header') %>

<div class="public-center">
<div class="w-100">
    <div class="text-center mb-4">
        <img class="eco-logo float" src="/img/logo.svg" width="62" height="62" alt="EcoGrow">
        <h1 class="mt-3 mb-1" style="font-size:2rem">Crear cuenta</h1>
        <p class="text-muted-eco small mb-0">Empieza a cuidar tus cultivos con datos 🌱</p>
    </div>

    <div class="auth-box glass p-4 p-md-5">
        <form action="/registro" method="POST">
            <div class="mb-3">
                <label class="form-label" for="nombre">Nombre</label>
                <div class="input-icon">
                    <i class="bi bi-person"></i>
                    <input type="text" id="nombre" name="nombre" class="form-control" placeholder="Tu nombre" required>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="correo">Correo electrónico</label>
                <div class="input-icon">
                    <i class="bi bi-envelope"></i>
                    <input type="email" id="correo" name="correo" class="form-control" placeholder="tu@correo.com" required>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="contrasena">Contraseña</label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <input type="password" id="contraseña" name="contrasena" minlength="6" class="form-control" placeholder="••••••••" required>
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label" for="confirmar">Confirmar contraseña</label>
                <div class="input-icon">
                    <i class="bi bi-lock-fill"></i>
                    <input type="password" id="confirmar" name="confirmar" minlength="6" class="form-control" placeholder="••••••••" required>
                </div>
            </div>
            <button class="btn btn-eco w-100 py-2" style="color:var(--primary-foreground)">Registrarme</button>
        </form>
        <p class="text-center mt-3 mb-0 small text-muted-eco">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
    </div>
</div>
</div>

<%- include('../partials/footer') %>
