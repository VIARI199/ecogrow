<%- include('partials/header') %>
<div class="mb-4"><h1>Cámara en vivo 📷</h1><p class="text-muted-eco">Observa el espacio y revisa posibles anomalías visuales.</p></div>
<div class="row g-3"><div class="col-lg-8"><div class="glass p-2"><div class="cam-frame"><img src="/img/camera-feed.jpg" alt="Vista del invernadero"><span class="pill cam-live"><span class="dot <%= dispositivo && dispositivo.estado === 'Online' ? 'dot-ok' : 'dot-warn' %> me-0"></span> <%= dispositivo && dispositivo.estado === 'Online' ? 'Nodo conectado' : 'Imagen de referencia' %></span></div></div></div><div class="col-lg-4"><div class="glass p-4 h-100"><h5>Análisis visual</h5><p class="small text-muted-eco"><%= analisis %></p><div class="border rounded p-3 small">Crecimiento foliar: pendiente<br>Sequedad visible: pendiente<br>Anomalías: pendiente</div><% if (dispositivo) { %><div class="small text-muted-eco mt-3">Última comunicación: <%= dispositivo.ultima_comunicacion ? new Date(dispositivo.ultima_comunicacion).toLocaleString('es-CL') : 'sin registro' %></div><% } %></div></div></div>
<%- include('partials/footer') %>
