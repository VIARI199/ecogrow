<%- include('partials/header') %>
<div class="mb-4"><h1>Configuración</h1><p class="text-muted-eco">Personaliza cómo recibes y visualizas la información.</p></div>
<form action="/app/configuracion" method="POST" class="glass p-4 col-lg-8">
    <div class="form-check form-switch mb-4"><input class="form-check-input" type="checkbox" name="notificaciones" id="notificaciones" <%= preferencias.notificaciones ? 'checked' : '' %>><label class="form-check-label" for="notificaciones">Activar notificaciones</label><div class="form-text">Recibir avisos cuando una planta requiera atención.</div></div>
    <label class="form-label">Unidad de temperatura</label><select class="form-select mb-4" name="unidad"><option value="C" <%= preferencias.unidad === 'C' ? 'selected' : '' %>>Celsius (°C)</option><option value="F" <%= preferencias.unidad === 'F' ? 'selected' : '' %>>Fahrenheit (°F)</option></select>
    <div class="form-check form-switch mb-4"><input class="form-check-input" type="checkbox" name="compacto" id="compacto" <%= preferencias.compacto ? 'checked' : '' %>><label class="form-check-label" for="compacto">Vista compacta</label></div>
    <button class="btn btn-eco">Guardar preferencias</button>
</form>
<%- include('partials/footer') %>
