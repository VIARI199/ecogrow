<%- include('partials/header') %>
<%
  const hora = new Date().getHours();
  const saludo = hora < 12 ? 'Buenos días' : hora < 20 ? 'Buenas tardes' : 'Buenas noches';
  const iconos = { temperatura: 'thermometer-half', humedad_ambiente: 'moisture', humedad_suelo: 'droplet-half', luz: 'brightness-high' };
%>

<div class="mb-4">
    <h1 class="fs-2 mb-1"><%= saludo %>, <%= usuario.nombre %> 🌱</h1>
    <p class="text-muted-eco mb-2">Cada dato cuenta para un cultivo más sano y sostenible.</p>
    <span class="pill"><span class="dot dot-<%= estadoGeneralClase %> me-0"></span> Sistema: <%= estadoGeneral %></span>
</div>

<div class="row g-3 mb-4">
    <% [
        ['invernaderos', 'buildings', 'Invernaderos', totales.invernaderos],
        ['plantaciones', 'flower1', 'Plantaciones activas', totales.plantaciones],
        ['dispositivos', 'wifi', 'ESP32 en línea', totales.online + ' / ' + totales.dispositivos],
        ['alertas', 'bell', 'Alertas nuevas', totales.alertas]
    ].forEach(([key, i, t, v], n) => { %>
        <div class="col-6 col-lg-3">
            <div class="glass p-3 h-100" data-delay="<%= n * 80 %>">
                <div class="d-flex align-items-center gap-2 text-muted-eco small"><span class="icon-chip" style="width:2rem;height:2rem;font-size:.95rem"><i class="bi bi-<%= i %>"></i></span> <%= t %></div>
                <div class="fs-3 fw-semibold font-display mt-2" data-dashboard-total="<%= key %>"><%= v %></div>
            </div>
        </div>
    <% }) %>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
    <h4 class="mb-0">Telemetría en tiempo real</h4>
    <span id="dashboard-refresh-status" class="small text-muted-eco">Actualización automática cada 30 segundos</span>
</div>
<div id="dashboard-sensors" class="row g-3 mb-4">
<% if (ultimas.length === 0) { %>
    <div class="col-12"><div class="glass empty-state">📡 Todavía no hay lecturas. Conecta un ESP32 para empezar.</div></div>
<% } %>
    <% [
        ['temperatura', 'thermometer-half', 'Temperatura ambiente', '°C'],
        ['humedad_ambiente', 'moisture', 'Humedad relativa del aire', '%'],
        ['humedad_suelo', 'droplet-half', 'Humedad del suelo', '%'],
        ['luz', 'brightness-high', 'Nivel de iluminación', 'lux'],
        ['co2', 'cloud-haze2', 'Calidad del aire / CO₂', 'ppm']
    ].forEach(([variable, icono, titulo, unidad], n) => {
        const l = ultimas.find(lectura => lectura.nombre_variable === variable);
    %>
        <div class="col-sm-6 col-lg-3">
            <div class="glass hover p-3 sensor-card h-100" data-delay="<%= n * 70 %>">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="icono"><i class="bi bi-<%= icono %>"></i></span>
                    <span class="pill" style="padding:.2rem .6rem"><span class="dot <%= l ? 'dot-ok' : 'dot-warn' %> me-0"></span> <%= l ? 'En línea' : 'Sin datos' %></span>
                </div>
                <div class="text-muted-eco small mt-3"><%= titulo %></div>
                <div class="valor"><%= l ? Number(l.valor) : '—' %> <small class="fs-6 text-muted-eco fw-normal"><%= l ? l.unidad_medida : unidad %></small></div>
                <div class="small text-muted-eco mt-2"><%= l ? `${l.invernadero} · ${l.nombre_zona}` : 'Conecta el sensor para ver la medición' %></div>
                <% if (l) { %><div class="small text-muted-eco" style="font-size:.7rem"><%= new Date(l.fecha_hora).toLocaleString('es-CL') %></div><% } %>
            </div>
        </div>
    <% }) %>
    <div class="col-sm-6 col-lg-3">
        <div class="glass hover p-3 sensor-card h-100">
            <div class="d-flex justify-content-between align-items-start"><span class="icono"><i class="bi bi-broadcast-pin"></i></span><span class="pill" style="padding:.2rem .6rem"><span class="dot <%= totales.online > 0 ? 'dot-ok' : 'dot-crit' %> me-0"></span> <%= totales.online > 0 ? 'En línea' : 'Desconectado' %></span></div>
            <div class="text-muted-eco small mt-3">Conexión del nodo</div>
            <div class="valor"><%= totales.online %>/<%= totales.dispositivos %></div>
            <div class="small text-muted-eco mt-2"><%= totales.online > 0 ? 'ESP32 transmitiendo datos' : 'ESP32 apagado o sin comunicación' %></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-baseline mb-3">
            <h4 class="mb-0">Resumen de mis plantas</h4>
            <a href="/app/plantas" class="btn btn-sm btn-outline-eco">Ver todas</a>
        </div>
        <div class="row g-3 mb-1">
        <% if (plantaciones.length === 0) { %>
            <div class="col-12"><div class="glass empty-state">🌱 Añade tu primera planta para comenzar a monitorearla.</div></div>
        <% } %>
        <% plantaciones.forEach(p => { %>
            <div class="col-sm-6 col-lg-4">
                <a class="glass hover d-block p-3 h-100" href="/app/plantas">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong><%= p.nombre_comun %></strong>
                        <span class="dot <%= p.estado === 'Cosecha' ? 'dot-warn' : 'dot-ok' %>"></span>
                    </div>
                    <div class="small text-muted-eco mt-2"><%= p.invernadero %> · <%= p.nombre_zona %></div>
                    <div class="small text-muted-eco mt-1"><%= p.estado %></div>
                </a>
            </div>
        <% }) %>
        </div>
    </div>
    <div class="col-lg-7">
        <h4 class="mb-3">Vista del invernadero</h4>
        <div class="glass p-2">
            <div class="cam-frame">
                <img src="/img/camera-feed.jpg" alt="Interior del invernadero con luz verde">
                <span class="pill cam-live" style="background: rgba(20, 98, 74, 0.7)"><span class="dot dot-warn me-0"></span> Imagen de referencia</span>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <h4 class="mb-3">Últimas alertas</h4>
        <div class="glass p-3">
            <div id="dashboard-alerts-list">
            <% if (alertas.length === 0) { %>
                <p class="text-muted-eco mb-0"><span class="dot dot-ok"></span>Todo en orden, no hay alertas nuevas.</p>
            <% } %>
            <% alertas.forEach(a => { %>
                <div class="d-flex justify-content-between align-items-center gap-2 border-bottom py-2">
                    <span class="small"><span class="dot <%= a.nivel_urgencia === 'Critica' || a.nivel_urgencia === 'Alta' ? 'dot-crit' : 'dot-warn' %>"></span><%= a.mensaje %></span>
                    <span class="badge text-bg-secondary"><%= a.nivel_urgencia %></span>
                </div>
            <% }) %>
            </div>
            <a href="/app/alertas" class="btn btn-sm btn-outline-eco mt-3">Ver todas</a>
        </div>
    </div>
</div>

<script src="/js/dashboard.js" defer></script>
<%- include('partials/footer') %>
