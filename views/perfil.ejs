<%- include('partials/header') %>
<div class="mb-4"><h1>Mi perfil</h1><p class="text-muted-eco">Administra tus datos personales de EcoGrow.</p></div>
<div class="row g-3">
    <div class="col-lg-4"><div class="glass p-4 text-center h-100"><div class="avatar mx-auto mb-3" style="width:5rem;height:5rem;font-size:1.6rem"><%= perfil.nombre.split(' ').map(p => p[0]).slice(0, 2).join('').toUpperCase() %></div><h4><%= perfil.nombre %></h4><p class="text-muted-eco mb-0"><%= perfil.correo %></p><small class="text-muted-eco">Miembro desde <%= new Date(perfil.fecha_registro).toLocaleDateString('es-CL') %></small></div></div>
    <div class="col-lg-8"><form action="/app/perfil" method="POST" class="glass p-4"><label class="form-label">Nombre</label><input class="form-control mb-3" name="nombre" value="<%= perfil.nombre %>" required><label class="form-label">Correo electrónico</label><input class="form-control mb-3" type="email" name="correo" value="<%= perfil.correo %>" required><button class="btn btn-eco">Guardar cambios</button></form></div>
</div>
<%- include('partials/footer') %>
