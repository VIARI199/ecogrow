<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Zonas</h1>
    <a href="/zonas/create" class="btn btn-eco"><i class="bi bi-plus-lg"></i> Nueva zona</a>
</div>

<div class="glass p-3 table-responsive">
<% if (zonas.length === 0) { %>
    <div class="empty-state">No hay zonas registradas.</div>
<% } else { %>
    <table class="table align-middle mb-0">
        <thead><tr><th>Zona</th><th>Invernadero</th><th>Descripción</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        <% zonas.forEach(z => { %>
            <tr>
                <td><%= z.nombre_zona %></td>
                <td><%= z.invernadero %></td>
                <td class="text-muted-eco"><%= z.descripcion || '—' %></td>
                <td class="text-end">
                    <a href="/zonas/<%= z.ID_zona %>/edit" class="btn btn-sm btn-outline-light">Editar</a>
                    <form action="/zonas/<%= z.ID_zona %>/delete" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar zona?')">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
<% } %>
</div>

<%- include('../partials/footer') %>
